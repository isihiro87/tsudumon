{
  "hosting": [
    {
      "site": "tsudumon",
      "public": "dist-web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": false,
      "redirects": [
        {
          "source": "/tsudumon",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/tsudumon/:rest*",
          "destination": "/:rest*",
          "type": 301
        },
        {
          "source": "/parents.html",
          "destination": "/parents/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/dl",
          "function": {
            "functionId": "tsudumonDownload",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/chat",
          "function": {
            "functionId": "tsudumonLpChat",
            "region": "asia-northeast1"
          }
        }
      ],
      "headers": [
        {
          "source": "/img/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        },
        {
          "source": "/_shared/img/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        },
        {
          "comment": "下層ページの共通CSS",
          "source": "/css/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        },
        {
          "comment": "クローラ向けファイルは短めに",
          "source": "/{robots.txt,sitemap.xml}",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
        },
        {
          "source": "**/*.html",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
        },
        {
          "comment": "Service Worker 本体はキャッシュしない（更新が届かなくなるため）",
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            { "key": "Content-Type", "value": "application/manifest+json" },
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        }
      ]
    }
  ]
}
