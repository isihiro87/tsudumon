# --- secrets（絶対にコミットしない） ---
.env
**/.env
lp/.env

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- 生成物（generate_*.py と Edge で再生成できる） ---
output/

# --- Node / ビルド ---
node_modules/
lp/node_modules/
dist/

# 配信ビルド（Firebase Hosting の public）。deploy_tsudumon.py と lp/build-lp.mjs が
# 生成する。正本はジェネレータ・web/・lp/ 側なので追跡しない。
dist-web/

# Firebase CLI のローカルキャッシュ
.firebase/

# --- OS / エディタ ---
.DS_Store
Thumbs.db
*.swp

# --- 作業用バックアップ（画像の作り直し前の退避） ---
assets/_backup_smalltext/
assets/_backup_new5/
assets/reference/*-prefix.webp
assets/_*-old.webp

# 作業用一時データ
tmp/

# --- 歴史クエストの画像 ---
# PNG は Codex(image_generation) が出す原本で1枚1MB前後。配信するのは
# tools/quest_assets_to_webp.py が作る .webp だけなので、PNG は追跡しない。
# カンプ（デザインの正本）だけは残す。
assets/quest/*.png
!assets/quest/quest-top-mobile.png

# ブラウザ自動操作の使い捨てプロファイル
.edge-*/

# 出力・プレビュー・バックアップ・スクラッチ（再生成可能／git不要）
covers/out/
mascot-preview/
assets/_backup_answers/
scratch_*.log
dist/tts/

# --- 画像の中間生成物（Codex の作業ファイル。採用した1枚だけを追跡する） ---
# 52MB あり、採用画像（richmenu/*.png）が残っていれば作り直せる。
richmenu/.pro-work/

# --- insta: 投稿する面だけを追跡する ---
# 投稿するのは insta/out/<MMDD>/（0730 / 0801 / 0802 / 0803 / 0805）と、
# 連作の参照元 insta/out/_source/ だけ。それ以外は作業場・中間生成物なので追跡しない。
# 画像生成AIへの指示書（insta/_p-*.txt）はテキストなので追跡する＝作り直せる。
insta/assets/
insta/out/_archive/
insta/out/*/_old/
insta/out/_prev*.png

# 保護者用リッチメニューの作業場（richmenu/.pro-work/ と同じ扱い。
# 採用画像 richmenu/parent-*.png が残っていれば作り直せる）
richmenu/.parent-work/
